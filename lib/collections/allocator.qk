import containers::slice::{ str };
import io::{ _write_panic_head, panic };
import c::stdlib;
import c::string;

struct Allocator {
    void _panic_err(str message) {
        void extern fprintf(File* file, char* fmt, char* a);

        _write_panic_head();
        fprintf(extern<File*> stderr, message.data(), string::strerror(extern<Int> errno));
        stdlib::exit(extern<Int> EXIT_FAILURE);
    }

    T* alloc<T>(usize size) {
        T* memory = stdlib::malloc(size);
        if(!memory) _panic_err("[Allocator::alloc] malloc() failed: %s\n");
        return memory;
    }

    T* alloc_array<T>(usize n) {
        if(n > extern<usize> SIZE_MAX / sizeof(T))
             panic("[Allocator::alloc_array] multiplication overflow between input size and element size");
        T* memory = stdlib::malloc(n * sizeof(T));
        if(!memory) _panic_err("[Allocator::alloc_array] malloc() failed: %s\n");
        return memory;
    }

    T* realloc<T>(T* ptr, usize size) {
        T* memory = stdlib::realloc(ptr, size);
        if(!memory) _panic_err("[Allocator::realloc] realloc() failed: %s\n");
        return memory;
    }

    T* realloc_array<T>(T* ptr, usize n) {
        if(n > extern<usize> SIZE_MAX / sizeof(T))
             panic("[Allocator::realloc_array] multiplication overflow between input size and element size");
        T* memory = stdlib::realloc(ptr, n * sizeof(T));
        if(!memory) _panic_err("[Allocator::realloc_array] realloc() failed: %s\n");
        return memory;
    }

    void free<T>(T* ptr) {
        stdlib::free(ptr);
    }
}