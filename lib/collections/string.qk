import vector::{ Vec };
import containers::slice::{ str, Slice };

struct String {
	Vec<char> vector;

	String new() {
		return String { Vec::new() };
	}

	String from(str string) {
		Vec<char> vector = Vec::new();
		vector.push_many(string.slice);
		return String { vector };
	}

	str to_str(self) {
		return str { Slice { self.vector.data, self.vector.size } };
	}

	String* cat(&self, str string) {
		self->vector.push_many(string.slice);
		return self;
	}

	char* to_cstr(&self) {
	    self->vector.reserve(1);
	    self->vector.data[self->vector.size] = '\0';
		return self->vector.data;
	}
}

String str::to_owned(str self) {
	String string = String::new();
	string.vector.push_many(self.slice);
	return string;
}