import containers::slice::{ Slice };
import operator::{ Operator };
import allocator::{ Allocator };
import io::{ panic };

struct Vec<T> {
	T* data;
	usize size;
	usize capacity;

	Vec<T> new() {
		return Vec {
			data: Allocator::alloc(sizeof(T)),
			size: 0,
			capacity: 1,
		};
	}

	Vec<T> from_capacity(usize capacity) {
        return Vec {
            data: Allocator::alloc_array(capacity),
            size: 0,
            capacity: capacity,
        };
	}

	usize len(self) {
		return self.size;
	}

	void reserve(&self, usize n) {
	    if(self->size + n > extern<usize> SIZE_MAX / 2)
            panic("[Vec::reserve] capacity overflow");

		if(self->size + n <= self->capacity) return;
		while(self->capacity < self->size + n) self->capacity *= 2;

		self->data = Allocator::realloc_array(self->data, self->capacity);
	}

	void push(&self, T item) {
		self->reserve(1);
		self->data[self->size++] = item;
	}

	void push_many(&self, [T] slice) {
		self->reserve(slice.size);

        for(int i = 0; i < slice.size; i++) {
			self->data[self->size++] = slice.data[i];
        }
	}

	Vec<T> from([T] slice) {
        T* extern malloc<T>(usize size);

		Vec<T> vec = Vec {
			data: malloc(sizeof(T) * slice.size),
			size: 0,
			capacity: slice.size,
		};
		vec.push_many(slice);

		return vec;
	}

	void pop(&self) {
		self->size--;
	}

	T Operator::index(self, usize index) {
	    return self.data[index];
	}
}
