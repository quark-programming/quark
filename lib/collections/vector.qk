import containers::slice::{ Slice };
import operator::{ Operator };
import allocator::{ Allocator };
import io::{ panic };
import c::string::{ memcpy };
import iterator::{ Iterator, IntoIter };
import containers::option::{ Option };

struct Vec<T> : IntoIter<T> {
	T* data;
	usize size;
	usize capacity;

	Vec<T> new() {
		return Vec { 0 };
	}

	Vec<T> from([T] slice) {
		Vec<T> vec = Vec {
			data: Allocator::alloc_array(slice.size),
			size: slice.size,
			capacity: slice.size,
		};
		memcpy(vec.data, slice.data, sizeof(T) * slice.size);

		return vec;
	}

	Vec<T> from_capacity(usize capacity) {
        return Vec {
            data: Allocator::alloc_array(capacity),
            size: 0,
            capacity: capacity,
        };
	}

	usize len(self) {
		return self.size;
	}

	void reserve(&self, usize n) {
	    if(self->size + n > extern<usize> SIZE_MAX / 2) panic("[Vec::reserve] capacity overflow");

		if(self->size + n <= self->capacity) return;
		if(!self->capacity) self->capacity = 1;
		while(self->capacity < self->size + n) self->capacity *= 2;

		self->data = Allocator::realloc_array(self->data, self->capacity);
	}

	void push(&self, T item) {
		self->reserve(1);
		self->data[self->size++] = item;
	}

	void push_many(&self, [T] slice) {
		self->reserve(slice.size);

        memcpy(self->data + self->size, slice.data, slice.size * sizeof(T));
        self->size += slice.size;
	}

	void pop(&self) {
		self->size--;
	}

	void free(self) {
        Allocator::free(self.data);
	}

	T Operator::index(self, usize index) {
	    return self.data[index];
	}

	struct Iter : Iterator<T> {
        Vec<T> vector;
        usize index;

        T? Iterator::next(&self) {
            if(self->index >= self->vector.len()) return Option::None();
            return Option::Some(self->vector[self->index++]);
        }
	}

	Iter IntoIter<T, Iter>::iter(self) {
        return Iter { self, 0 };
	}
}
