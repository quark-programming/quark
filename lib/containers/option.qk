import slice::{ str };

struct Option<T> {
	T value;
	bool some;

	Option<T> Some(T value) {
		return Option { value, true };
	}

	Option<T> None() {
		return Option { some: false };
	}

	bool is_some(self) {
		return self.some;
	}

	bool is_none(self) {
		return !self.some;
	}

	T unwrap(self) {
		// if(!self.some) panic("[Option::unwrap] Unwrapped on None");
		return self.value;
	}

	T expect(self, str message) {
		// if(!self.some) panic(message);
		return self.value;
	}

    T unwrap_or(self, T default) {
		if(self.some) return self.value;
		return default;
	}
}
