import containers::slice::{ str };
import containers::option::{ Option };
import c::stdio::{ FILE, fopen, fclose, fwrite };
import c::stdlib::{ exit };

struct File {
    FILE* file;

    static File stdin;
    static File stdout;
    static File stderr;

    File? open(str filename, str mode) {
        usize filename_len = filename.len();
        char* extern filename_buffer;

        extern {
            char filename_buffer[filename_len + 1];
            memcpy(filename_buffer, filename.slice.data, filename_len);
            filename_buffer[filename_len] = '\0';
        };

        FILE* file = fopen(filename_buffer, mode.data());
        if(file) {
            return Option::Some(File { file });
        }
    }

    File? new(str filename) {
        return File::open(filename, "w+");
    }

    void close(self) {
        fclose(self.file);
    }

    void write(self, str data) {
        fwrite(data.data(), sizeof(char), data.len(), self.file);
    }

    void print(self, str data) {
        self.write(data);
        char newline = '\n';
        fwrite(&newline, sizeof(char), 1, self.file);
    }
}

File::stdin = File { extern<FILE*> stdin };
File::stdout = File { extern<FILE*> stdout };
File::stderr = File { extern<FILE*> stderr };

void write(str message) {
    File::stdout.write(message);
}

void print(str message) {
    File::stdout.print(message);
}

void _write_panic_head() {
    File::stderr.write("[\x1b[31mpanicked\x1b[0m]:\n\t");
}

void panic(str message) {
    _write_panic_head();
    File::stderr.print(message);
	exit(extern<Int> EXIT_FAILURE);
}

void print_i64(i64 number) {
    usize extern printf(char* fmt, i64 n);
    printf("%jd\n".data(), number);
}

void print_u64(u64 number) {
    usize extern printf(char* fmt, u64 n);
    printf("%ju\n".data(), number);
}

void print_i32(i32 number) { print_i64(number.(i64)); }
void print_u32(u32 number) { print_u64(number.(u64)); }
void print_i16(i16 number) { print_i64(number.(i64)); }
void print_u16(u16 number) { print_u64(number.(u64)); }
void print_i8(i8 number) { print_i64(number.(i64)); }
void print_u8(u8 number) { print_u64(number.(u64)); }
